{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",

  "transient_prompt": {
    "background": "transparent",
    "foreground": "cyan",
    "template": "{{ .Folder }} <green>➜ </>"
  },

  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "cyan",
          "background": "transparent",
          "properties": {
            "style": "agnoster_full",
            "home_icon": "~",
            "folder_separator_icon": "/"
          },
          "template": "{{ .Path }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "blue",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}red{{ end }}",
            "{{ if gt .Ahead 0 }}green{{ end }}"
          ],
          "background": "transparent",
          "properties": {
            "branch_icon": "git:(",
            "fetch_status": true
          },
          "template": " | {{ .HEAD }}{{ .BranchStatus }}){{ if or (.Working.Changed) (.Staging.Changed) }} <yellow>✗</>{{ else }} <green>✔</>{{ end }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "overflow": "hidden",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "foreground": "blue",
          "background": "p:background",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "properties": {
            "threshold": 100,
            "style": "austin",
            "always_enabled": false
          },
          "template": " {{ .FormattedMs }} "
        },
        {
          "type": "root",
          "style": "diamond",
          "foreground": "red",
          "background": "p:background",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": " \u26a1 root "
        },
        {
          "type": "sysinfo",
          "style": "diamond",
          "foreground": "blue",
          "background": "p:background",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "properties": {
            "precision": 1
          },
          "template": "{{ printf \"%.1f\" (divf (sub .PhysicalTotalMemory .PhysicalAvailableMemory) 1073741824.0) }}/{{ printf \"%.1f\" (divf .PhysicalTotalMemory 1073741824.0) }} GB"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground_templates": [
            "{{ if gt .Code 0 }}red{{ end }}"
          ],
          "foreground": "green",
          "background": "transparent",
          "template": "➜"
        }
      ]
    }
  ],
  "palette": {
    "background": "#192934"
  }
}
